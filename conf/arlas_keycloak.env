ARLAS_SERVER_JDK_JAVA_OPTIONS=${ARLAS_SERVER_JDK_JAVA_OPTIONS} -Djavax.net.ssl.trustStore=/opt/app/arlas-ks.jks -Djavax.net.ssl.trustStorePassword=arlaspassword

ARLAS_AUTHENT_CLEAR_HASH=true
ARLAS_AUTHENT_CLIENT_ID=arlas-front
ARLAS_AUTHENT_DISABLE_AT_HASH_CHECK=true
ARLAS_AUTHENT_ENABLE_SESSION_CHECKS=true
ARLAS_AUTHENT_FORCE_CONNECT=false
ARLAS_AUTHENT_ISSUER=https://${ARLAS_HOST}:9443/auth/realms/arlas
ARLAS_AUTHENT_REDIRECT_URI=https://${ARLAS_HOST}:443/wui/callback
ARLAS_AUTHENT_REQUIRE_HTTPS=false
ARLAS_AUTHENT_RESPONSE_TYPE=code
ARLAS_AUTHENT_SCOPE=profile
ARLAS_AUTHENT_SHOW_DEBUG=false
#ARLAS_AUTHENT_SILENT_REFRESH_REDIRECT_URI
ARLAS_AUTHENT_SILENT_REFRESH_TIMEOUT=1000
ARLAS_AUTHENT_STORAGE=memorystorage
#ARLAS_AUTHENT_THRESHOLD=
ARLAS_AUTHENT_TIMEOUT_FACTOR=0.75
ARLAS_AUTHENT_USE_DISCOVERY=true
ARLAS_CHECK_ORGANISATIONS=false
ARLAS_AUTH_KEYCLOAK_REALM=arlas
ARLAS_AUTH_KEYCLOAK_RESOURCE=arlas-backend
ARLAS_AUTH_KEYCLOAK_SECRET="rha14c4202RB0Dxlke6ZNCCTw9gkvLJ8"
ARLAS_AUTH_KEYCLOAK_URL=https://${ARLAS_HOST}:9443/auth
ARLAS_AUTH_POLICY_CLASS=io.arlas.filter.impl.KeycloakPolicyEnforcer
ARLAS_USE_AUTHENT=true

KEYCLOAK_ADMIN_LOGIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CONF_DIRECTORY=${PWD}/conf/keycloak
HTTP_JAVA_HEALTHCHECK_PATH=${PWD}/resources/HttpHealthcheck.java
ARLAS_WUI_URL=https://${ARLAS_HOST}/wui/
ARLAS_BUILDER_URL=https://${ARLAS_HOST}/builder/
ARLAS_PERSISTENCE_URL=https://${ARLAS_HOST}/persist
ARLAS_SERVER_URL=https://${ARLAS_HOST}/arlas
ARLAS_AUTH_PUBLIC_URIS="swagger.*:*,stac:GET,openapi.json:GET,stac/.*:GET/POST,explore/.*:GET/POST,persist/.*:GET,authorize/resources:GET"

ARLAS_AUTHENT_MODE=openid
