# Namespace where the Kubernetes secrets will be created.
# It must match the namespace used by the arlas-stack Helm release.
NAMESPACE=

## ARLAS STACK SECRETS
# Environment variables used by the arlas-stack Helm chart.
# They are stored in the Kubernetes secret named `arlas-stack-secret`
# and exposed to the applications as literal environment variables.

# Keycloak client secret associated with the realm used by ARLAS.
ARLAS_APP_KEYCLOAK_SECRET=

# Username used to connect to SeaweedFS.
ARLAS_APP_SEAWEEDFS_LOGIN=

# Password used to connect to SeaweedFS.
ARLAS_APP_SEAWEEDFS_PASSWORD=

# Celery broker URL.
# Format: pyamqp://{rabbitmq-user}:{rabbitmq-password}@{rabbitmq-service-name}:{rabbitmq-port}//
ARLAS_APP_CELERY_BROKER_URL=

# Celery result backend URL.
# Format: redis://:{redis-password}@{redis-service-name}:{redis-port}/0
ARLAS_APP_CELERY_RESULT_BACKEND=

# Password used to connect to Redis.
ARLAS_APP_REDIS_PASSWORD=

# Password used to connect to the SMTP server.
# Optional: leave empty if SMTP authentication is not required.
ARLAS_APP_SMTP_PASSWORD=

# Username used to connect to Elasticsearch.
# If Elasticsearch is deployed with the arlas-stack chart:
# it will also be present in the Kubernetes secret `${ES_CLUSTER_NAME}-user`
# under the `username` key.
ARLAS_APP_ELASTIC_LOGIN=

# Password used to connect to Elasticsearch.
# If Elasticsearch is deployed with the arlas-stack chart:
# it will also be present in the Kubernetes secret `${ES_CLUSTER_NAME}-user`
# under the `password` key.
ARLAS_APP_ELASTIC_PASSWORD=

## KEYCLOAK SECRETS
# Required only if Keycloak and PostgreSQL are deployed with the arlas-stack chart.

# Username used to access the Keycloak administration interface.
# Stored in the Kubernetes secret `keycloak-bootstrap-admin` under the `username` key.
ARLAS_APP_KEYCLOAK_LOGIN=

# Password used to access the Keycloak administration interface.
# Stored in the Kubernetes secret `keycloak-bootstrap-admin` under the `password` key.
ARLAS_APP_KEYCLOAK_PASSWORD=

# Username used by Keycloak to connect to PostgreSQL.
# Stored in the Kubernetes secret `keycloak-db` under the `username` key.
ARLAS_APP_POSTGRES_LOGIN=

# Password used by Keycloak to connect to PostgreSQL.
# Stored in the Kubernetes secret `keycloak-db` under the `password` key.
ARLAS_APP_POSTGRES_PASSWORD=

## RABBITMQ SECRETS
# Required only if RabbitMQ is deployed with the arlas-stack chart.

# Username used to connect to RabbitMQ.
# Stored in the Kubernetes secret `arlas-rabbitmq-default-user` under the `username` key.
ARLAS_APP_RABBITMQ_LOGIN=

# Password used to connect to RabbitMQ.
# Stored in the Kubernetes secret `arlas-rabbitmq-default-user` under the `password` key.
ARLAS_APP_RABBITMQ_PASSWORD=